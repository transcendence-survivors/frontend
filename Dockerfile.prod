# ---------------------------------------------------
# 1. Base Stage: Install PNPM
# ---------------------------------------------------
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@10.15.0
RUN pnpm config set store-dir /pnpm/store

# ---------------------------------------------------
# 2. Dependencies Stage: Install node_modules
# ---------------------------------------------------
FROM base AS deps
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/network/client/package.json ./apps/network/client/package.json
COPY apps/game/ui/package.json ./apps/game/ui/package.json
COPY apps/game/shared-package/package.json ./apps/game/shared-package/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------------------------------------------------
# 3. Builder Stage: Build Next.js
# ---------------------------------------------------
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/network/client/node_modules ./apps/network/client/node_modules
COPY --from=deps /app/apps/game/ui/node_modules ./apps/game/ui/node_modules
COPY --from=deps /app/apps/game/shared-package/node_modules ./apps/game/shared-package/node_modules

COPY apps/network/client ./apps/network/client
COPY apps/game/ui ./apps/game/ui
COPY apps/game/shared-package ./apps/game/shared-package
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# Build arguments for Next.js static generation & env validation
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_PUBLIC_GAME_SOCKET_URL
ARG NEXT_PUBLIC_CHAT_SOCKET_URL
ARG JWT_SECRET
ARG API_INTERNAL

# Expose them as environment variables during build time
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_GAME_SOCKET_URL=$NEXT_PUBLIC_GAME_SOCKET_URL
ENV NEXT_PUBLIC_CHAT_SOCKET_URL=$NEXT_PUBLIC_CHAT_SOCKET_URL
ENV JWT_SECRET=$JWT_SECRET
ENV API_INTERNAL=$API_INTERNAL

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/network/client
RUN pnpm build

# ---------------------------------------------------
# 4. Runner Stage: Lightweight Production Runtime
# ---------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone build server, public assets, and static files
COPY --from=builder /app/apps/network/client/public ./apps/network/client/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/network/client/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/network/client/.next/static ./apps/network/client/.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "apps/network/client/server.js"]